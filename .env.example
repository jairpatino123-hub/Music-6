 (cd "$(git rev-parse --show-toplevel)" && printf '%s' 'diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000000000000000000000000000000000000..5d8cc545e622672b39d135f921591de762c8149b
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,10 @@
+# Create OAuth 2.0 Web application credentials in Google Cloud Console.
+# Add http://localhost:3000/api/youtube/callback as an authorized redirect URI.
+YOUTUBE_CLIENT_ID=replace-with-google-client-id
+YOUTUBE_CLIENT_SECRET=replace-with-google-client-secret
+YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
+# Use a long unpredictable value in production (at least 32 characters).
+SESSION_SECRET=replace-with-a-long-random-secret
+PORT=3000
+# Comma-separated origins allowed to call this service. Empty allows same-origin only.
+ALLOWED_ORIGINS=http://localhost:3000
' | git apply --3way)
